{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"schema":{"type":"string","const":"xiaosi.release/1"},"release_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{7,79}$"},"plugin_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"version":{"type":"string","maxLength":32,"pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},"channel":{"type":"string","const":"stable"},"publisher_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},"runtime":{"type":"string","const":"agent"},"compatibility":{"type":"object","properties":{"tpi":{"type":"string","const":"1.0"},"core":{"type":"string","minLength":1,"maxLength":200},"platforms":{"minItems":1,"maxItems":6,"type":"array","items":{"type":"string","pattern":"^(?:win32|darwin|linux)-(?:x64|arm64)$"}}},"required":["tpi","core","platforms"],"additionalProperties":false},"data_schema":{"type":"number","const":1},"migration_kind":{"type":"string","const":"none"},"permission_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_commit":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}},"required":["schema","release_id","plugin_id","version","channel","publisher_id","runtime","compatibility","data_schema","migration_kind","permission_digest","source_commit"],"additionalProperties":false,"title":"XPI immutable release descriptor"}